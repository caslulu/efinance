# Database and application
DATABASE_URL=postgresql://financeuser:financepass@localhost:5432/financepro?schema=public
JWT_SECRET=replace-with-a-long-random-secret
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:3000
FORCE_HTTPS=false

# Gmail SMTP
# Enable two-step verification on the Google account and use an App Password.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=finance-app@gmail.com
MAIL_PASS=replace-with-google-app-password
MAIL_FROM="Finance Pro <finance-app@gmail.com>"

# IA: chat e importação assistida (chaves somente no backend)
# Cloud: informe a chave. Servidor próprio: altere a URL; a chave é opcional.
OLLAMA_BASE_URL=https://ollama.com
OLLAMA_API_KEY=
OLLAMA_MODEL=gpt-oss:20b
