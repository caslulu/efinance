# Finance Pro - local Docker Compose environment
# Copy this file to .env if you want to override the defaults.

DB_USER=financeuser
DB_PASSWORD=financepass
DB_NAME=financepro

# Local frontend talks to the backend through the Vite proxy by default.
VITE_API_URL=/api

# Email credentials belong in backend/.env (see backend/.env.example).

# Optional local integrations
OLLAMA_API_KEY=
OLLAMA_BASE_URL=https://ollama.com
OLLAMA_MODEL=gpt-oss:20b
