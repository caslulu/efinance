Project FinancePro {
  database_type: "PostgreSQL"
  Note: "Modelo local derivado de backend/prisma/schema.prisma. O schema Prisma e a fonte canonica."
}

Enum Frequency {
  WEEKLY
  MONTHLY
  QUARTERLY
  YEARLY
}

Enum SubscriptionStatus {
  ACTIVE
  PAUSED
  CANCELLED
}

Enum ChatRole {
  USER
  ASSISTANT
}

Enum InvestmentMarket {
  BR
  GLOBAL
}

Enum InvestmentOperationType {
  BUY
  SELL
  DIVIDEND
  JCP
}

Table User {
  id int [pk, increment]
  username text [not null]
  email text [not null, unique]
  password text
  fullName text
  avatarUrl text
  birthDate timestamp
  resetToken text
  resetTokenExpiry timestamp
  twoFactorToken text
  twoFactorTokenExpiry timestamp
  isTwoFactorEnabled boolean [not null, default: false]
  isEmailVerified boolean [not null, default: false]
  emailVerificationToken text
  emailVerificationTokenExpiry timestamp
}

Table Wallet {
  id int [pk, increment]
  user_id int [not null]
  actual_cash decimal(10,2) [not null]
  name text [not null]
  type text [not null]
  order int [not null, default: 0]
  is_transfer_only boolean [not null, default: false]
}

Table Card {
  id int [pk, increment]
  wallet_id int [not null]
  name text [not null]
  flag text [not null]
  closing_day int [not null]
  due_day int [not null]
  card_limit decimal(10,2) [not null]
  usable_limit decimal(10,2) [not null]
}

Table Transaction {
  id int [pk, increment]
  transaction_date timestamp [not null]
  wallet_id int [not null]
  card_id int
  transaction_type text [not null]
  payment_method text
  description text
  is_recurring boolean [not null]
  value decimal(10,2) [not null]
  installment_id text
  installment_total int
  installment_number int
  is_processed boolean [not null, default: true]
  category_id int [not null]
  subscription_id int
}

Table Subscription {
  id int [pk, increment]
  user_id int [not null]
  wallet_id int [not null]
  category_id int [not null]
  name text [not null]
  description text
  value decimal(10,2) [not null]
  transaction_type text [not null, default: "EXPENSE"]
  frequency Frequency [not null]
  status SubscriptionStatus [not null, default: "ACTIVE"]
  start_date timestamp [not null]
  next_billing_date timestamp [not null]
  payment_method text
  icon text
  card_id int
}

Table TransactionCategory {
  id int [pk, increment]
  user_id int [not null]
  name text [not null]
  icon text
}

Table Budget {
  id int [pk, increment]
  user_id int [not null]
  category_id int [not null]
  limit decimal(10,2) [not null]

  indexes {
    (user_id, category_id) [unique]
  }
}

Table Investment {
  id int [pk, increment]
  start_date timestamp [not null]
  maturity_date timestamp
  wallet_id int [not null]
  investment_category int [not null]
  investment_amount decimal(10,2) [not null]
  current_amount decimal(10,2) [not null]
  name text [not null]
  indicator_id int
  percentage_of_indicator decimal(10,2)
  fix_rate decimal(10,2)
}

Table EconomicIndicator {
  id int [pk, increment]
  name text [not null]
  current_rate decimal(10,2) [not null]
  last_update timestamp [not null]
}

Table TypeInvestment {
  investment_category int [pk, increment]
  name text [not null]
}

Table InvestmentPosition {
  id int [pk, increment]
  wallet_id int [not null]
  symbol text [not null]
  market InvestmentMarket [not null]
  asset_type text [not null, default: "LISTED"]
  currency text [not null]
  quantity decimal(18,6) [not null]
  average_cost decimal(18,6) [not null]
  invested_amount decimal(18,6) [not null]
  invested_amount_brl decimal(18,6) [not null]
  realized_pnl decimal(18,6) [not null, default: 0]
  realized_pnl_brl decimal(18,6) [not null, default: 0]
  dividends_received decimal(18,6) [not null, default: 0]
  dividends_received_brl decimal(18,6) [not null, default: 0]
  jcp_received decimal(18,6) [not null, default: 0]
  jcp_received_brl decimal(18,6) [not null, default: 0]
  last_market_price decimal(18,6)
  last_market_price_brl decimal(18,6)
  last_market_at timestamp
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null]

  indexes {
    (wallet_id, symbol, market, asset_type) [unique]
    (wallet_id, market, asset_type)
    (symbol, market, asset_type)
  }
}

Table InvestmentOperation {
  id int [pk, increment]
  wallet_id int [not null]
  position_id int
  type InvestmentOperationType [not null]
  symbol text [not null]
  market InvestmentMarket [not null]
  asset_type text [not null, default: "LISTED"]
  currency text [not null]
  quantity decimal(18,6)
  unit_price decimal(18,6)
  gross_amount decimal(18,6) [not null]
  gross_amount_brl decimal(18,6) [not null]
  fx_rate decimal(18,6)
  cdb_cdi_percentage decimal(10,4)
  cdb_cdi_rate decimal(10,4)
  transaction_date timestamp [not null]
  source_event_key text [unique]
  notes text
  created_at timestamp [not null, default: `now()`]

  indexes {
    (wallet_id, symbol, market, transaction_date)
    (position_id, transaction_date)
  }
}

Table Wishlist {
  id int [pk, increment]
  user_id int [not null]
  name text [not null]
}

Table WishlistProduct {
  id int [pk, increment]
  id_wishlist int [not null]
  name_product text [not null]
  price decimal(10,2) [not null]
  url text
  send_price_alerts boolean [not null, default: false]
  last_checked_price decimal(10,2)
}

Table WishlistProductHistory {
  id int [pk, increment]
  wishlist_product_id int [not null]
  price decimal(10,2) [not null]
  created_at timestamp [not null, default: `now()`]

  indexes {
    wishlist_product_id
  }
}

Table WishlistPriceAlertNotification {
  id int [pk, increment]
  user_id int [not null]
  wishlist_product_id int [not null]
  old_price decimal(10,2) [not null]
  new_price decimal(10,2) [not null]
  message text [not null]
  is_read boolean [not null, default: false]
  notified_at timestamp [not null, default: `now()`]

  indexes {
    (user_id, is_read)
    wishlist_product_id
  }
}

Table ChatConversation {
  id int [pk, increment]
  user_id int [not null]
  title text
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null]

  indexes {
    user_id
  }
}

Table ChatMessage {
  id int [pk, increment]
  conversation_id int [not null]
  role ChatRole [not null]
  content text [not null]
  created_at timestamp [not null, default: `now()`]

  indexes {
    conversation_id
  }
}

Table ChatDailyUsage {
  id int [pk, increment]
  user_id int [not null]
  usage_date date [not null]
  questions_count int [not null, default: 0]
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null]

  indexes {
    (user_id, usage_date) [unique]
    (user_id, usage_date)
  }
}

Ref: Wallet.user_id > User.id
Ref: Card.wallet_id > Wallet.id [delete: cascade]
Ref: Transaction.wallet_id > Wallet.id
Ref: Transaction.card_id > Card.id [delete: set null]
Ref: Transaction.category_id > TransactionCategory.id
Ref: Transaction.subscription_id > Subscription.id
Ref: Subscription.user_id > User.id
Ref: Subscription.wallet_id > Wallet.id
Ref: Subscription.category_id > TransactionCategory.id
Ref: Subscription.card_id > Card.id [delete: set null]
Ref: TransactionCategory.user_id > User.id
Ref: Budget.user_id > User.id
Ref: Budget.category_id > TransactionCategory.id
Ref: Investment.wallet_id > Wallet.id
Ref: Investment.investment_category > TypeInvestment.investment_category
Ref: Investment.indicator_id > EconomicIndicator.id
Ref: InvestmentPosition.wallet_id > Wallet.id [delete: cascade]
Ref: InvestmentOperation.wallet_id > Wallet.id [delete: cascade]
Ref: InvestmentOperation.position_id > InvestmentPosition.id [delete: set null]
Ref: Wishlist.user_id > User.id
Ref: WishlistProduct.id_wishlist > Wishlist.id
Ref: WishlistProductHistory.wishlist_product_id > WishlistProduct.id
Ref: WishlistPriceAlertNotification.user_id > User.id
Ref: WishlistPriceAlertNotification.wishlist_product_id > WishlistProduct.id
Ref: ChatConversation.user_id > User.id
Ref: ChatMessage.conversation_id > ChatConversation.id [delete: cascade]
Ref: ChatDailyUsage.user_id > User.id [delete: cascade]
